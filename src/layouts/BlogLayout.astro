---
import Fonts from '../components/Fonts.astro';
interface Props { title: string; description?: string }
const { title, description } = Astro.props;
---
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} – Ostgrat</title>
{description && <meta name="description" content={description} />}
<Fonts />
</head>
<body>
<header class="top">
  <a href="/" class="brand">Ostgrat</a>
  <nav><a href="/blog/">News &amp; Insights</a><a href="/#kontakt">Kontakt</a></nav>
</header>
<main><slot /></main>
<footer class="foot"><a href="/">← Zur Startseite</a></footer>
<style is:global>
  :root { --bg:#0f0e12; --ink:#f1eee8; --mut:#c2bfc6; --line:color-mix(in srgb,#f1eee8 12%,transparent); --acc:#f0704f; --sw:1px; }
  * { box-sizing:border-box }
  html,body { margin:0; background:var(--bg); color:var(--ink) }
  body { font:400 17px/1.55 "Space Grotesk",system-ui,sans-serif; -webkit-font-smoothing:antialiased }
  a { color:inherit; text-decoration:none }
  .top { position:sticky; top:0; display:flex; justify-content:space-between; align-items:stretch; height:56px; background:var(--bg); border-bottom:var(--sw) solid var(--line); z-index:2 }
  .brand { display:flex; align-items:center; padding:0 24px; font:500 20px "IBM Plex Serif",serif }
  .top nav { display:flex }
  .top nav a { display:flex; align-items:center; padding:0 20px; border-left:var(--sw) solid var(--line); font-size:15px }
  .top nav a:hover { background:var(--ink); color:var(--bg) }
  main { max-width:1180px; margin:0 auto; padding:clamp(56px,10vh,120px) 24px }
  .lab { font:400 12px/1.2 "Space Grotesk",sans-serif; letter-spacing:.12em; text-transform:uppercase; color:var(--acc) }
  h1,h2,h3 { font-family:"IBM Plex Serif",serif; font-weight:400; letter-spacing:-.02em; line-height:1.1 }
  h1 { font-size:clamp(40px,5vw,72px); margin:.3em 0 .5em }
  .foot { border-top:var(--sw) solid var(--line); padding:32px 24px; font-size:15px; color:var(--mut) }
</style>
</body>
</html>
