---
// Gemeinsames Layout für alle Unterseiten (Seitenbaukasten, Blog). Startseite hat ihr eigenes Markup.
import logo from '../legacy/logo.svg?raw';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/#team', label: 'Über uns' },
  { href: '/#services', label: 'Leistungen' },
  { href: '/#branchen', label: 'Branchen' },
  { href: '/blog/', label: 'News' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---
<html lang="de">
<head>
<meta charset="utf-8">
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png"><link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} – Ostgrat</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="stylesheet" href="/styles/fonts.css">
<link rel="stylesheet" href="/styles/site.css">
</head>
<body>
<div class="frame">
  <header class="top">
    <a class="brand" href="/" aria-label="Ostgrat Startseite" set:html={logo}></a>
    <nav aria-label="Hauptnavigation">{nav.map((n) => (
      <a href={n.href} class:list={{ on: n.href !== '/' && path.startsWith(n.href) }}><span>{n.label}</span></a>
    ))}</nav>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <a class="brand" href="/" aria-label="Ostgrat Startseite" set:html={logo}></a>
    <p>Ostgrat Security · Cybersecurity von IT bis OT</p>
    <p><a href="/blog/">News &amp; Insights</a> · <a href="/#kontakt">Kontakt</a></p>
  </footer>
</div>
<script is:inline src="/scripts/grid.js" defer></script>
</body>
</html>
