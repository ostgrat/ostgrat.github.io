---
// Gemeinsames Layout für alle Unterseiten (Seitenbaukasten, Blog). Startseite hat ihr eigenes Markup.
import Fonts from '../components/Fonts.astro';
import logo from '../legacy/logo.svg?raw';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/#team', label: 'Über uns' },
  { href: '/#services', label: 'Leistungen' },
  { href: '/#branchen', label: 'Branchen' },
  { href: '/blog/', label: 'News' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} – Ostgrat</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<Fonts />
</head>
<body>
<div class="frame">
  <header class="top">
    <a class="brand" href="/" aria-label="Ostgrat Startseite" set:html={logo}></a>
    <nav aria-label="Hauptnavigation">{nav.map((n) => (
      <a href={n.href} class:list={{ on: n.href !== '/' && path.startsWith(n.href) }}><span>{n.label}</span></a>
    ))}</nav>
  </header>
  <main><slot /></main>
  <footer class="foot">
    <a class="brand" href="/" aria-label="Ostgrat Startseite" set:html={logo}></a>
    <p>Ostgrat Security · Cybersecurity von IT bis OT</p>
    <p><a href="/blog/">News &amp; Insights</a> · <a href="/#kontakt">Kontakt</a></p>
  </footer>
</div>
<style is:global>
  :root {
    color-scheme: dark;
    --bg:#0f0e12; --ink:#f1eee8; --mut:#c2bfc6; --acc:#f0704f; --army:#a4b26c;
    --line:color-mix(in srgb,#f1eee8 9%,transparent); --ln:color-mix(in srgb,#f1eee8 16%,transparent);
    --box:color-mix(in srgb,#f1eee8 4%,transparent);
    --fh:"IBM Plex Serif",Georgia,serif; --fb:"Space Grotesk",system-ui,sans-serif; --fm:"JetBrains Mono",ui-monospace,monospace;
    --sw:1px; --frame:12px; --pad:clamp(24px,8.333vw,128px);
  }
  * { box-sizing:border-box; min-width:0 }
  html,body { margin:0; background:var(--bg); color:var(--ink) }
  body { font:400 17px/1.42 var(--fb); -webkit-font-smoothing:antialiased }
  a { color:inherit; text-decoration:none }
  img { display:block; max-width:100% }
  ::selection { background:var(--ink); color:var(--bg) }
  :focus-visible { outline:var(--sw) solid var(--acc); outline-offset:3px }
  .frame { margin:var(--frame); border:var(--sw) solid var(--line); min-height:calc(100vh - 2 * var(--frame)); display:flex; flex-direction:column }
  .top { position:sticky; top:0; z-index:3; display:flex; justify-content:space-between; height:56px; margin:calc(-1 * (var(--frame) + var(--sw))) calc(-1 * (var(--frame) + var(--sw))) 0; padding:0 calc(var(--frame) + var(--sw)); background:var(--bg); border-bottom:var(--sw) solid var(--line) }
  .brand { display:flex; align-items:center; padding:0 16px }
  .brand svg { height:24px; width:auto; fill:currentColor }
  .top nav { display:flex }
  .top nav a { display:flex; align-items:center; padding:0 16px; border-left:var(--sw) solid var(--line); font-size:15px; transition:background .3s,color .3s }
  .top nav a:hover, .top nav a.on { background:var(--ink); color:var(--bg) }
  @media (max-width:760px) { .top nav a:not(:last-child) { display:none } }
  main { flex:1 }
  .foot { display:grid; grid-template-columns:auto 1fr auto; gap:24px; align-items:center; padding:32px var(--pad) 40px calc(var(--pad) - 16px); border-top:var(--sw) solid var(--line); color:var(--mut); font-size:15px }
  .foot p { margin:0 }
  .foot a:hover { color:var(--ink) }
  @media (max-width:760px) { .foot { grid-template-columns:1fr } }

  /* Typo-Bausteine */
  .lab { margin:0 0 24px; color:var(--mut); font:500 15px/1.2 var(--fb); letter-spacing:.11em; text-transform:uppercase }
  .h1 { margin:0; font:400 clamp(48px,6.2vw,96px)/1.02 var(--fh); letter-spacing:-.04em }
  .h2 { margin:0 0 24px; font:400 clamp(32px,3.4vw,46px)/1.12 var(--fh); letter-spacing:-.035em; max-width:18ch }
  .h3 { margin:0; font:500 clamp(19px,1.5vw,23px)/1.3 var(--fh); letter-spacing:-.015em }
  .hl { display:block; width:fit-content; margin:.14em 0 0 -.1em; padding:0 .3em; background:var(--ink); color:var(--bg) }
  .lead { max-width:46ch; color:var(--mut) }
  .prose { color:var(--mut); max-width:64ch }
  .prose > :first-child { margin-top:0 } .prose > :last-child { margin-bottom:0 }
  .prose h2, .prose h3 { color:var(--ink); font-family:var(--fh); font-weight:400; letter-spacing:-.02em; line-height:1.2; margin:1.6em 0 .5em }
  .prose h2 { font-size:30px } .prose h3 { font-size:23px }
  .prose strong { color:var(--ink); font-weight:500 }
  .prose a { color:var(--ink); text-decoration:underline; text-decoration-thickness:var(--sw); text-underline-offset:3px }
  .prose ul, .prose ol { padding-left:1.2em } .prose li { margin:.3em 0 }
  .prose li::marker { color:var(--acc) }

  /* Button wie auf der Startseite */
  .cta { display:inline-flex; align-items:stretch; height:44px; font-size:15px }
  .cta b { display:flex; align-items:center; padding:0 16px; font-weight:400; background:color-mix(in srgb,var(--ink) 12%,transparent); transition:background .3s }
  .cta > i { display:flex; align-items:center; justify-content:flex-end; width:44px; padding-right:12px; background:var(--acc); color:var(--bg); transition:width .25s cubic-bezier(.3,1.2,.5,1) }
  .cta > i svg { width:20px; height:20px; fill:currentColor }
  .cta:hover b { background:color-mix(in srgb,var(--ink) 18%,transparent) }
  .cta:hover > i { width:48px }

  /* Sections des Baukastens */
  .blk { padding:clamp(96px,16vh,180px) var(--pad) 0 }
  .blk:last-child { padding-bottom:clamp(96px,16vh,180px) }
</style>
</body>
</html>
