---
// Startseite in einer Sprache. Deutsch: src/data/home.json · Englisch: src/data/home.en.json (fehlt sie, gilt Deutsch).
import homeDe from '../data/home.json';
import FramePage from './FramePage.astro';
import type { Lang } from '../lib/blog';
interface Props { lang: Lang }
const { lang } = Astro.props;
const enFiles = import.meta.glob('../data/home.en.json', { eager: true, import: 'default' });
const home: any = lang === 'en' ? (Object.values(enFiles)[0] ?? homeDe) : homeDe;
const title = lang === 'en' ? 'Ostgrat – Security for mid-sized companies' : 'Ostgrat – Sicherheit für den Mittelstand';
---
<FramePage lang={lang} title={title} alt={lang === 'en' ? '/' : '/en/'} blocks={home.blocks} home />
