---
import icons from '../../legacy/icons.json';
const { kicker, heading, items = [] } = Astro.props;
---
<section class="blk b-faq">
  <div>{kicker && <p class="lab">{kicker}</p>}{heading && <h2 class="h2">{heading}</h2>}</div>
  <div class="list">{items.map((it: { question: string; answer: string }, i: number) => (
    <details name="faq" open={i === 0}><summary><h3 class="h3">{it.question}</h3><i set:html={icons.chevron}></i></summary><p>{it.answer}</p></details>
  ))}</div>
</section>
<style>
  .b-faq { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:clamp(40px,6vw,120px); align-items:start }
  .list { border-top:var(--sw) solid var(--line); interpolate-size:allow-keywords }
  details { border-bottom:var(--sw) solid var(--line) }
  summary { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:24px 0; list-style:none; cursor:pointer }
  summary::-webkit-details-marker { display:none }
  summary i { flex:none; display:grid; place-items:center; width:34px; height:34px; border:var(--sw) solid var(--line); transition:background .3s,color .3s,border-color .3s }
  summary i :global(svg) { width:14px; height:14px; fill:currentColor; transition:rotate .45s cubic-bezier(.2,.7,.2,1) }
  details[open] summary i { background:var(--ink); border-color:var(--ink); color:var(--bg) }
  details[open] summary i :global(svg) { rotate:180deg }
  details::details-content { block-size:0; overflow:hidden; transition:block-size .5s cubic-bezier(.2,.7,.2,1),content-visibility .5s allow-discrete }
  details[open]::details-content { block-size:auto }
  details p { margin:0; padding:0 64px 28px 0; max-width:64ch; color:var(--mut) }
  @media (max-width:900px) { .b-faq { grid-template-columns:1fr; gap:8px } details p { padding-right:0 } }
</style>
