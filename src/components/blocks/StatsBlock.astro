---
const { kicker, heading, items = [] } = Astro.props;
---
<section class="blk b-stats">
  {kicker && <p class="lab">{kicker}</p>}
  {heading && <h2 class="h2">{heading}</h2>}
  <dl>{items.map((it: { value: string; label: string }) => (
    <div><dt>{it.value}</dt><dd>{it.label}</dd></div>
  ))}</dl>
</section>
<style>
  dl { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); margin:48px 0 0; border-top:var(--sw) solid var(--line) }
  dl div { padding:32px 24px 8px 0; border-right:var(--sw) solid var(--line) }
  dl div:not(:first-child) { padding-left:24px }
  dl div:last-child { border-right:0 }
  dt { font:400 clamp(48px,5vw,76px)/1 var(--fh); letter-spacing:-.04em }
  dd { margin:16px 0 0; color:var(--mut); max-width:24ch }
  @media (max-width:700px) { dl div { border-right:0; border-bottom:var(--sw) solid var(--line); padding:28px 0 } dl div:not(:first-child) { padding-left:0 } }
</style>
