---
import { md } from '../../lib/md';
const { kicker, heading, body } = Astro.props;
---
<section class="blk b-text">
  <div>{kicker && <p class="lab">{kicker}</p>}{heading && <h2 class="h2">{heading}</h2>}</div>
  <div class="prose" set:html={md(body)} />
</section>
<style>
  .b-text { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:clamp(40px,6vw,120px); align-items:start }
  .prose { padding-top:6px }
  @media (max-width:900px) { .b-text { grid-template-columns:1fr; gap:8px } }
</style>
