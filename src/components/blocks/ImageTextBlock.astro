---
import Cta from '../Cta.astro';
import { md } from '../../lib/md';
const { kicker, heading, body, image, imagePosition, ctaLabel, ctaLink } = Astro.props;
---
<section class:list={['blk', 'b-it', { right: imagePosition === 'rechts' }]}>
  <figure>{image && <img src={image} alt="" loading="lazy" />}</figure>
  <div class="txt">
    {kicker && <p class="lab">{kicker}</p>}
    {heading && <h2 class="h2">{heading}</h2>}
    <div class="prose" set:html={md(body)} />
    {ctaLabel && ctaLink && <Cta href={ctaLink} label={ctaLabel} />}
  </div>
</section>
<style>
  .b-it { display:grid; grid-template-columns:minmax(0,6fr) minmax(0,5fr); gap:clamp(40px,6vw,120px); align-items:center }
  .b-it.right { grid-template-columns:minmax(0,5fr) minmax(0,6fr) }
  .b-it.right figure { order:2 }
  figure { margin:0; aspect-ratio:4/3; border:var(--sw) solid var(--line); overflow:hidden; background:var(--box) }
  figure img { width:100%; height:100%; object-fit:cover }
  .txt :global(.cta) { margin-top:36px }
  @media (max-width:900px) { .b-it, .b-it.right { grid-template-columns:1fr } .b-it.right figure { order:0 } }
</style>
