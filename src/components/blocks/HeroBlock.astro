---
import Cta from '../Cta.astro';
const { kicker, headline, highlight, lead, ctaLabel, ctaLink, image } = Astro.props;
---
<section class:list={['blk', 'b-hero', { 'has-img': image }]}>
  <div class="copy">
    {kicker && <p class="lab">{kicker}</p>}
    <h1 class="h1">{headline}{highlight && <span class="hl">{highlight}</span>}</h1>
    {lead && <p class="lead">{lead}</p>}
    {ctaLabel && ctaLink && <Cta href={ctaLink} label={ctaLabel} />}
  </div>
  {image && <figure><img src={image} alt="" /></figure>}
</section>
<style>
  .b-hero { display:grid; grid-template-columns:minmax(0,1fr); gap:clamp(40px,6vw,96px); align-items:end; padding-top:clamp(120px,22vh,240px) }
  .b-hero.has-img { grid-template-columns:minmax(0,7fr) minmax(0,5fr) }
  .lead { margin:40px 0 0 }
  .copy :global(.cta) { margin-top:44px }
  figure { margin:0; aspect-ratio:4/5; border:var(--sw) solid var(--line); overflow:hidden }
  figure img { width:100%; height:100%; object-fit:cover }
  @media (max-width:900px) { .b-hero.has-img { grid-template-columns:1fr } figure { aspect-ratio:4/3 } }
</style>
