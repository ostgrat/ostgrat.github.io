---
// Setzt eine Seite aus den Blöcken zusammen, die im CMS gestapelt wurden.
// Das HTML kommt aus src/lib/blocks.mjs – derselbe Code rendert die Live-Vorschau im CMS.
import { renderBlocks } from '../lib/blocks.mjs';
import { md } from '../lib/md';
import { getPosts, toCard } from '../lib/blog';
const { blocks = [], lang = 'de' } = Astro.props;
const posts = blocks.some((b: any) => b?.type === 'blogTeaser') ? (await getPosts(lang)).map(toCard) : [];
---
<Fragment set:html={renderBlocks(blocks, { md, posts })} />
