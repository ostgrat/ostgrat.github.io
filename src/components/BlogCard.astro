---
// Beitragskarte im Stil der Startseite (Bild, Titel, Kurztext, Autor/Datum).
import icons from '../legacy/icons.json';
import { formatDate, inlineSvg, postUrl, types, type Post } from '../lib/blog';
interface Props { post: Post; showType?: boolean }
const { post: p, showType } = Astro.props;
const svg = inlineSvg(p.data.cover);
---
<article class:list={['card', { 'is-alert': p.alert }]}>
  <a class="hit" href={postUrl(p)} aria-label={p.data.title}></a>
  <figure>
    {svg ? <Fragment set:html={svg} /> : p.data.cover ? <img src={p.data.cover} alt="" loading="lazy" /> : null}
    {p.alert && <Fragment set:html={icons.alert} />}
  </figure>
  {showType && !p.alert && <p class="type">{types[p.type]}</p>}
  <h3 class="h3">{p.data.title}</h3>
  <p class="ex">{p.data.excerpt}</p>
  <p class="meta"><span>{p.data.author}</span><span>{formatDate(p.data.date)}</span></p>
</article>
<style>
  .card { position:relative }
  .hit { position:absolute; inset:0; z-index:1 }
  figure { position:relative; margin:0 0 24px; aspect-ratio:16/9; overflow:hidden; border:var(--sw) solid var(--line); background:var(--box) }
  figure :global(svg:not(.bl-alert svg)), figure img { display:block; width:100%; height:100%; object-fit:cover }
  figure :global(.bl-alert) { position:absolute; top:14px; right:14px; display:flex; align-items:center; gap:8px; height:26px; padding:0 10px; background:var(--acc); color:var(--bg); font:500 12px/1 var(--fb); letter-spacing:.12em; text-transform:uppercase }
  figure :global(.bl-alert i) { width:6px; height:6px; background:currentColor }
  .type { margin:0 0 10px; color:var(--acc); font:500 12px/1.2 var(--fb); letter-spacing:.12em; text-transform:uppercase }
  .h3 { font-size:clamp(21px,1.7vw,26px); line-height:1.2 }
  .card:hover .h3 { text-decoration:underline; text-decoration-thickness:var(--sw); text-underline-offset:4px }
  .ex { margin:12px 0 18px; color:var(--mut) }
  .meta { display:flex; gap:16px; margin:0; color:var(--mut); font-size:14px }
</style>
