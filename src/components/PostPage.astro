---
// Detailseite eines Beitrags (beide Sprachen) im Rahmen der Startseite. Je nach Beitragsart mit Warnungs- oder Fallstudien-Bereichen.
// Feste Beschriftungen sind deutsch; auf /en/ übersetzt sie die Middleware (src/i18n/en.json).
import FramePage from './FramePage.astro';
import icons from '../legacy/icons.json';
import { formatDate, categories, types, inlineSvg, type Post } from '../lib/blog';
interface Props { post: Post; alt: string }
const { post, alt } = Astro.props;
const d: any = post.data;
const e = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
const svg = inlineSvg(d.cover);
const severity: Record<string, string> = { kritisch: 'Kritisch', hoch: 'Hoch', mittel: 'Mittel' };
const fact = (k: string, v: string, cls = '') => `<div${cls ? ` class="${cls}"` : ''}><dt>${k}</dt><dd>${v}</dd></div>`;
const facts = post.type === 'warnungen'
  ? [d.cve && fact('Kennung', `<span class="mono">${e(d.cve)}</span>`), d.severity && fact('Schweregrad', `<span class="sev ${e(d.severity)}">${severity[d.severity] ?? e(d.severity)}</span>`), d.affected?.length && fact('Betroffen', `<ul>${d.affected.map((a: string) => `<li>${e(a)}</li>`).join('')}</ul>`)]
  : post.type === 'fallstudien'
  ? [d.industry && fact('Branche', e(d.industry)), d.companySize && fact('Unternehmensgröße', e(d.companySize)), d.duration && fact('Umfang', e(d.duration))]
  : [];
const factHtml = facts.filter(Boolean).join('');
const html = `<section class="pst ${post.type}" data-bi="0" data-block="beitrag" data-theme="dunkel" aria-labelledby="h-post">
  <article class="pst-in">
    <div class="pst-hd">
      <p class="pst-lab">${post.alert ? '<span class="pst-flag"><i></i>Sicherheitswarnung</span>' : `${types[post.type]} · ${categories[post.cat]}`}</p>
      <h1 id="h-post">${e(d.title)}</h1>
      <p class="pst-meta">${e(d.author)} · ${formatDate(d.date, post.lang)}</p>
    </div>
    ${factHtml ? `<dl class="pst-facts">${factHtml}</dl>` : ''}
    ${svg || d.cover ? `<figure class="pst-fig">${svg || `<img src="${e(d.cover)}" alt="">`}</figure>` : ''}
    ${post.type === 'warnungen' && d.actions?.length ? `<section class="pst-todo"><h2>Was Sie jetzt tun sollten</h2><ol>${d.actions.map((a: string) => `<li>${e(a)}</li>`).join('')}</ol></section>` : ''}
    ${post.type === 'fallstudien' && d.results?.length ? `<dl class="pst-res">${d.results.map((r: any) => `<div><dt>${e(r.value)}</dt><dd>${e(r.label)}</dd></div>`).join('')}</dl>` : ''}
    ${post.type === 'fallstudien' ? `<div class="pst-steps">${[['Ausgangslage', d.challenge], ['Vorgehen', d.approach], ['Ergebnis', d.outcome]].filter((x) => x[1]).map(([k, v]) => `<section><p class="pst-lab">${k}</p><p>${e(v)}</p></section>`).join('')}</div>` : ''}
    <div class="pst-body">${post.rendered?.html ?? ''}</div>
    <p class="pst-back"><a href="/blog/"><i>${icons.arrow}</i>Alle Beiträge</a></p>
  </article>
</section>`;
---
<FramePage lang={post.lang} title={`${d.title} – Ostgrat`} description={d.excerpt} alt={alt} html={html} />
