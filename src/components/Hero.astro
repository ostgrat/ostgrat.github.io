---
// Hero: Texte kommen aus src/data/home.json und sind im CMS unter „Seiten → Startseite“ editierbar.
import home from '../data/home.json';
import icons from '../legacy/icons.json';
import rest from '../legacy/hero-rest.html?raw';
const h = home.hero;
---
<section class="hero">
    <div class="copy">
      <h1><span class="ln">{h.line1}</span> <span class="ln">{h.line2}</span> <span class="ln hl typing">{h.highlight}</span></h1>
      <p class="hero-k sub">{h.kicker}</p>
      <p class="lead">{h.lead}</p>
      <a class="cta" href={h.ctaLink}><b><span>{h.ctaLabel}</span></b><i set:html={icons.arrow}></i></a>
    </div>
<Fragment set:html={rest} />
</section>
