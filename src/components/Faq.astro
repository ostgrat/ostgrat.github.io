---
// FAQ: Fragen und Antworten sind im CMS unter „Seiten → Startseite → FAQ“ editierbar.
import home from '../data/home.json';
import icons from '../legacy/icons.json';
const f = home.faq;
---
<section class="fq" id="faq" aria-labelledby="h-fq">
    <div class="fq-l"><p class="lab fq-k">{f.kicker}</p><h2 id="h-fq">{f.heading}</h2><div class="fq-box"><p class="fq-bs">{f.boxText}</p><a class="cta fq-cta" href={`mailto:${f.email}`}><b><span>{f.email}</span></b><i set:html={icons.arrow}></i></a></div></div>
    <div class="fq-list">{f.items.map((it, i) => (
      <details name="faq" open={i === 0}><summary><h3>{it.question}</h3><i set:html={icons.chevron}></i></summary><p>{it.answer}</p></details>
    ))}</div>
  </section>
