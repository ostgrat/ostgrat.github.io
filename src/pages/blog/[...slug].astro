---
// Beitragsseiten Deutsch. Aufbau: src/components/PostPage.astro
import PostPage from '../../components/PostPage.astro';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const [mine, other] = await Promise.all([getPosts('de'), getPosts('en')]);
  const other_ = new Map(other.map((p) => [p.slug, p]));   /* gleiche Datei = gleicher Beitrag */
  return mine.map((post) => { const o = other_.get(post.slug);
    return { params: { slug: post.path }, props: { post, alt: o ? `/en/blog/${o.path}/` : '/en/blog/' } }; });
}
const { post, alt } = Astro.props;
---
<PostPage post={post} alt={alt} />
