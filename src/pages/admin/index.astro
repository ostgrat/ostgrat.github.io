---
// CMS-Startseite (/admin/). Sveltia wird hier mitgebaut statt von einem CDN geladen –
// so lädt das CMS keine Dateien von fremden Servern. Konfiguration: public/admin/config.yml
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Ostgrat – Inhalte bearbeiten</title>
  <link rel="stylesheet" href="/admin/admin.css" />
</head>
<body>
  <script>
    import CMS, { React } from '@sveltia/cms';
    import { marked } from 'marked';
    import { renderBlocks } from '../../lib/blocks.mjs';

    const md = (s) => (s ? marked.parse(String(s), { async: false }) : '');

    // Daten aus der Vorschau-Entry holen (Immutable.js oder einfaches Objekt)
    const toData = (entry) => {
      const e = entry?.toJS ? entry.toJS() : entry;
      return e?.data ?? {};
    };

    // Bild-URL für die Vorschau: frisch hochgeladene Bilder kommen über getAsset,
    // bereits veröffentlichte über ihren normalen Pfad.
    const makeAsset = (getAsset) => (path) => {
      try {
        const a = getAsset?.(path);
        if (a && typeof a.then !== 'function') {
          const url = String(a.url ?? a);
          if (url && url !== '[object Object]') return url;
        }
      } catch {}
      return path;
    };

    // Live-Vorschau für Seiten aus dem Baukasten: dasselbe HTML wie auf der Website
    function PagePreview({ entry, getAsset }) {
      const data = toData(entry);
      const html = renderBlocks(data.blocks || [], { md, asset: makeAsset(getAsset) });
      return React.createElement('main', { className: 'preview', dangerouslySetInnerHTML: { __html: html } });
    }


    // ---------- Startseite: echte Seite laden und Texte live austauschen ----------
    const escH = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    // gleiche Buchstaben-Struktur wie das Startseiten-Skript (für Hover- und Einblend-Effekte)
    const wrap = (t) => String(t).split(' ').map((w) => `<span style="white-space: nowrap;">${[...w].map((c) => `<i>${escH(c)}</i>`).join('')}</span>`).join(' ');
    const norm = (s) => String(s ?? '').replace(/\s+/g, ' ').trim();

    // setzt Text nur, wenn er sich wirklich geändert hat (sonst würden Animationen neu starten)
    const setText = (el, value, { wrapped = true } = {}) => {
      if (!el || value == null || value === '' || norm(el.textContent) === norm(value)) return false;
      if (wrapped) el.innerHTML = wrap(value); else el.textContent = value;
      return true;
    };

    function applyHome(doc, data) {
      const h = data.hero || {};
      const f = data.faq || {};
      let heroChanged = false, faqChanged = false;
      const q = (sel) => doc.querySelector(sel);

      heroChanged = setText(q('.hero .hero-k'), h.kicker) || heroChanged;
      const lns = doc.querySelectorAll('.hero h1 .ln');
      heroChanged = setText(lns[0], h.line1) || heroChanged;
      heroChanged = setText(lns[1], h.line2) || heroChanged;
      if (lns[2] && setText(lns[2], h.highlight)) {
        lns[2].classList.remove('typing');
        lns[2].style.removeProperty('--clip');
        heroChanged = true;
      }
      heroChanged = setText(q('.hero .lead'), h.lead) || heroChanged;
      const heroCta = q('.hero .copy .cta');
      if (heroCta) {
        heroChanged = setText(heroCta.querySelector('b span'), h.ctaLabel) || heroChanged;
        if (h.ctaLink) heroCta.setAttribute('href', h.ctaLink);
      }

      faqChanged = setText(q('#faq .fq-k'), f.kicker, { wrapped: false }) || faqChanged;
      faqChanged = setText(q('#h-fq'), f.heading) || faqChanged;
      faqChanged = setText(q('#faq .fq-bs'), f.boxText) || faqChanged;
      const faqCta = q('#faq .fq-cta');
      if (faqCta && f.email) {
        faqChanged = setText(faqCta.querySelector('b span'), f.email) || faqChanged;
        faqCta.setAttribute('href', `mailto:${f.email}`);
      }
      const list = q('#faq .fq-list');
      const items = (f.items || []).filter((it) => it && (it.question || it.answer));
      if (list && items.length) {
        const current = [...list.querySelectorAll('details')].map((d) => norm(d.textContent)).join('|');
        const wanted = items.map((it) => norm(`${it.question ?? ''}${it.answer ?? ''}`)).join('|');
        if (current !== wanted) {
          const tpl = list.querySelector('details');
          list.replaceChildren(...items.map((it, i) => {
            const d = tpl.cloneNode(true);
            d.open = i === 0;
            d.querySelector('summary h3').textContent = it.question ?? '';
            d.querySelector('p').innerHTML = wrap(it.answer ?? '');
            return d;
          }));
          faqChanged = true;
        }
      }
      return { heroChanged, faqChanged };
    }

    function HomePreview({ entry }) {
      const data = toData(entry);
      const frame = React.useRef(null);
      React.useEffect(() => {
        const f = frame.current;
        if (!f) return;
        const run = () => {
          const doc = f.contentDocument;
          if (!doc?.querySelector('.hero')) return;
          const { heroChanged, faqChanged } = applyHome(doc, data);
          // zum bearbeiteten Bereich scrollen
          if (faqChanged) doc.querySelector('#faq')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          else if (heroChanged) f.contentWindow.scrollTo({ top: 0, behavior: 'smooth' });
        };
        run();
        f.addEventListener('load', run);
        return () => f.removeEventListener('load', run);
      });
      return React.createElement('iframe', {
        ref: frame,
        src: `${location.origin}/`,
        title: 'Vorschau Startseite',
        style: { display: 'block', width: '100%', height: '100vh', border: 0 },
      });
    }

    CMS.registerPreviewStyle('/styles/fonts.css');
    CMS.registerPreviewStyle('/styles/site.css');
    CMS.registerPreviewStyle('main.preview{min-height:100vh}.preview .blk:last-child{padding-bottom:96px}', { raw: true });
    CMS.registerPreviewTemplate('seiten', PagePreview);
    CMS.registerPreviewTemplate('startseite', HomePreview);
    CMS.registerPreviewTemplate('home', HomePreview); // Datei-Sammlungen: Vorlage über den Dateinamen
    CMS.init();
  </script>
</body>
</html>
