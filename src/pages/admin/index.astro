---
// CMS-Startseite (/admin/). Sveltia wird hier mitgebaut statt von einem CDN geladen –
// so lädt das CMS keine Dateien von fremden Servern. Konfiguration: public/admin/config.yml
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Ostgrat – Inhalte bearbeiten</title>
  <link rel="stylesheet" href="/admin/admin.css" />
</head>
<body>
  <script>
    import CMS, { React } from '@sveltia/cms';

    const h = React.createElement;

    // Daten aus der Vorschau-Entry holen (Immutable.js oder einfaches Objekt)
    const toData = (entry) => {
      const e = entry?.toJS ? entry.toJS() : entry;
      return e?.data ?? {};
    };

    // Bild-URL für die Vorschau: frisch hochgeladene Dateien kommen über getAsset, veröffentlichte über ihren Pfad
    const makeAsset = (getAsset) => (path) => {
      if (!path) return path;
      try {
        const a = getAsset?.(path);
        if (a && typeof a.then !== 'function') {
          const url = String(a.url ?? a);
          if (url && url !== '[object Object]') return url;
        }
      } catch {}
      return path;
    };

    // ---------- Gewählter Block: Klick oder Fokus im Editor links → Vorschau scrollt dorthin ----------
    let activeBlock = null;
    const onPick = (e) => {
      const el = e.target?.closest?.('[data-key-path]');
      const m = el?.getAttribute('data-key-path')?.match(/^blocks\.(\d+)/);
      if (!m) return;
      const i = Number(m[1]);
      if (i === activeBlock) return;
      activeBlock = i;
      window.dispatchEvent(new CustomEvent('ost-block', { detail: i }));
    };
    document.addEventListener('focusin', onPick, true);
    document.addEventListener('pointerdown', onPick, true);

    const useActiveBlock = (onChange) => {
      React.useEffect(() => {
        const fn = (e) => onChange(e.detail);
        window.addEventListener('ost-block', fn);
        return () => window.removeEventListener('ost-block', fn);
      }, []);
    };

    // ---------- Startseite: echte Seite (/vorschau/) mit allen Effekten, aus dem Entwurf gerendert ----------
    // Bei Änderungen wird im Hintergrund eine neue Vorschau geladen und erst getauscht, wenn sie fertig ist (kein Flackern).
    let homeDraft = null;
    window.__ostHomeDraft = () => homeDraft;

    const frameScroll = (frame, i, smooth) => {
      const w = frame?.contentWindow, d = frame?.contentDocument;
      const el = d?.querySelector(`[data-bi="${i}"]`);
      if (!w || !el) return;
      const dock = d.getElementById('hdr')?.getBoundingClientRect().bottom || 56;
      w.scrollTo({ top: el.getBoundingClientRect().top + w.scrollY - dock, behavior: smooth ? 'smooth' : 'instant' });
    };

    function HomePreview({ entry, getAsset }) {
      const data = toData(entry);
      const box = React.useRef(null);
      const state = React.useRef({ key: null, timer: 0 });
      homeDraft = { blocks: data.blocks || [], asset: makeAsset(getAsset) };

      useActiveBlock((i) => frameScroll(box.current?.querySelector('iframe.live'), i, true));

      React.useEffect(() => {
        const key = JSON.stringify(data.blocks || []);
        const st = state.current;
        if (key === st.key) return;
        const first = st.key === null;
        st.key = key;
        clearTimeout(st.timer);
        st.timer = setTimeout(() => {
          const holder = box.current;
          if (!holder) return;
          const old = holder.querySelector('iframe.live');
          const oldY = old?.contentWindow?.scrollY || 0;
          const f = document.createElement('iframe');
          f.title = 'Vorschau Startseite';
          f.src = `${location.origin}/vorschau/`;
          f.className = 'next';
          f.addEventListener('load', () => {
            if (activeBlock != null) frameScroll(f, activeBlock, false);
            else f.contentWindow.scrollTo(0, oldY);
            setTimeout(() => {   // Seitenskripte kurz anlaufen lassen, dann tauschen
              f.className = 'live';
              old?.remove();
            }, 350);
          }, { once: true });
          holder.appendChild(f);
        }, first ? 0 : 600);
      });

      return h('div', { ref: box, className: 'ost-home-preview' });
    }

    CMS.registerPreviewStyle('/styles/fonts.css');
    CMS.registerPreviewStyle(`main.preview{min-height:100vh}.preview .blk:last-child{padding-bottom:96px}
      .ost-home-preview{position:relative;height:100vh;overflow:hidden;background:#0f0e12}
      .ost-home-preview iframe{position:absolute;inset:0;width:100%;height:100%;border:0;transition:opacity .25s}
      .ost-home-preview iframe.next{opacity:0;pointer-events:none}
      .ost-home-preview iframe.live{opacity:1}`, { raw: true });
    CMS.registerPreviewTemplate('seiten', HomePreview);   // Seiten nutzen dieselben Blöcke und dieselbe Vorschau wie die Startseite
    CMS.registerPreviewTemplate('startseite', HomePreview);
    CMS.registerPreviewTemplate('home', HomePreview); // Datei-Sammlungen: Vorlage über den Dateinamen
    CMS.init();
  </script>
</body>
</html>
