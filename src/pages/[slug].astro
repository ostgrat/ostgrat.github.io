---
// Seiten aus dem CMS („Seiten“), Adresse = Dateiname. Gleiche Blöcke wie die Startseite (src/lib/home-blocks.mjs).
// Englisch: Datei name.en.md unter /en/<urlSlug oder name>/
import { getCollection } from 'astro:content';
import FramePage from '../components/FramePage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.draft);
  const en = new Map(pages.filter((p) => p.id.endsWith('.en')).map((p) => [p.id.slice(0, -3), p.data.urlSlug || p.id.slice(0, -3)]));
  return pages.filter((p) => !p.id.endsWith('.en')).map((page) => ({ params: { slug: page.id }, props: { page, alt: en.has(page.id) ? `/en/${en.get(page.id)}/` : '/en/' } }));
}
const { page, alt } = Astro.props;
---
<FramePage lang="de" title={`${page.data.title} – Ostgrat`} description={page.data.description} alt={alt} blocks={page.data.blocks} />
