---
// Seiten aus dem Seitenbaukasten (CMS → „Seiten“), Adresse = Dateiname. Englisch: Datei name.en.md unter /en/name/.
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Blocks from '../components/Blocks.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.draft);
  const en = new Map(pages.filter((p) => p.id.endsWith('.en')).map((p) => [p.id.slice(0, -3), p.data.urlSlug || p.id.slice(0, -3)]));
  return pages.filter((p) => !p.id.endsWith('.en')).map((page) => ({ params: { slug: page.id }, props: { page, alt: en.has(page.id) ? `/en/${en.get(page.id)}/` : '/en/' } }));
}
const { page, alt } = Astro.props;
---
<SiteLayout title={page.data.title} description={page.data.description} alt={alt}>
  <Blocks blocks={page.data.blocks} lang="de" />
</SiteLayout>
