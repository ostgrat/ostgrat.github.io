---
// Englische Seiten aus dem CMS: Datei name.en.md → /en/<urlSlug oder name>/
import { getCollection } from 'astro:content';
import FramePage from '../../components/FramePage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.draft && p.id.endsWith('.en'));
  return pages.map((page) => ({ params: { slug: page.data.urlSlug || page.id.slice(0, -3) }, props: { page } }));
}
const { page } = Astro.props;
---
<FramePage lang="en" title={`${page.data.title} – Ostgrat`} description={page.data.description} alt={`/${page.id.slice(0, -3)}/`} blocks={page.data.blocks} />
