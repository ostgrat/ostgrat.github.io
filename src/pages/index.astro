import Faq from '../components/Faq.astro';
import head from '../legacy/head.html?raw';
import body1 from '../legacy/body-1.html?raw';
import body2 from '../legacy/body-2.html?raw';
import body3 from '../legacy/body-3.html?raw';
import body4 from '../legacy/body-4.html?raw';
---
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
